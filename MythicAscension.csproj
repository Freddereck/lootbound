<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>MythicAscension</AssemblyName>
    <RootNamespace>MythicAscension</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GameDir>F:\SteamLibrary\steamapps\common\Lootbound</GameDir>
    <BepDir>$(GameDir)\BepInEx</BepDir>
    <NoWarn>CS0618;CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(BepDir)\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepDir)\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepDir)\core\0Harmony.dll" Private="false" />
    <Reference Include="$(BepDir)\core\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepDir)\core\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(BepDir)\interop\*.dll" Exclude="$(BepDir)\interop\netstandard.dll" Private="false" />
  </ItemGroup>
  <Target Name="DeployToGame" AfterTargets="Build">
    <MakeDir Directories="$(BepDir)\plugins\MythicAscension" />
    <Copy SourceFiles="$(TargetPath);items.json" DestinationFolder="$(BepDir)\plugins\MythicAscension" />
  </Target>
</Project>
